{
	"name": "savetoink",
	"description": "Save to Ink browser extension",
	"private": true,
	"version": "0.27.0-dev+03112322.246314c",
	"type": "module",
	"scripts": {
		"dev": "wxt",
		"dev:firefox": "wxt -b firefox",
		"build": "wxt build",
		"build:firefox": "wxt build -b firefox",
		"zip": "wxt zip",
		"zip:firefox": "wxt zip -b firefox",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"postinstall": "wxt prepare",
		"icons:generate": "bun run ../../tools/generate_icons.ts ../../favicon.svg icon-targets.csv"
	},
	"dependencies": {
		"@savetoink/shared": "*"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.3",
		"@eslint/js": "^9.39.4",
		"@tsconfig/svelte": "^5.0.8",
		"@wxt-dev/module-svelte": "^2.0.4",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.15.0",
		"globals": "^17.4.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"svelte": "^5.53.7",
		"svelte-check": "^4.4.4",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.56.1",
		"wxt": "^0.20.18",
		"@types/bun": "latest"
	}
}
