---
import { DEFAULT_TITLE, DEFAULT_DESCRIPTION } from "../lib/constants.astro";

interface Props {
  title?: string;
  description?: string;
}
const {
  title = DEFAULT_TITLE,
  description = DEFAULT_DESCRIPTION,
} = Astro.props;
import Head from "../components/Head.astro";
---

<!doctype html>
<html lang="en">
  <Head title={title} description={description} />

  <body>
    <slot />
  </body>
</html>
