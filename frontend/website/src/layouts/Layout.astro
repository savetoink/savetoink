---
interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Save To Ink — Save articles to your e-reader",
  description = "Save any article to your Kindle or Kobo in seconds. Clean EPUB delivery for focused reading.",
} = Astro.props;
import Head from "../components/Head.astro";
---

<!doctype html>
<html lang="en">
  <Head title={title} description={description} />

  <body>
    <slot />
  </body>
</html>
