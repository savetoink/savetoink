---
interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Save To Ink — Save articles to your e-reader",
  description = "Save any article to your Kindle or Kobo in seconds. Clean EPUB delivery for focused reading.",
} = Astro.props;
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Head from "../components/Head.astro";
---

<!doctype html>
<html lang="en">
  <Head title={title} description={description} />

  <body>
    <SiteNav />

    <main class="container">
        <slot />
    </main>

    <SiteFooter />
  </body>
</html>

<style>
	.container :global(h1) {
		font-size: clamp(2rem, 5vw, 2.75rem);
		margin-top: 1.5rem;
	}
</style>
