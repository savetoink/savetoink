---
import Layout from "./Layout.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<Layout {...Astro.props}>
  <SiteNav />
  <main class="container">
    <slot />
  </main>
  <SiteFooter />
</Layout>

<style>
	.container :global(h1) {
		font-size: clamp(2rem, 5vw, 2.75rem);
		margin-top: 1.5rem;
	}
</style>
