---
---

<section class="section">
  <div class="container">
    <p class="section-label">Features</p>
    <h2 class="section-heading">Everything you need,<br />nothing you don't</h2>
    <p class="section-sub">
      Built for readers who want the web's best writing on their best
      reading device.
    </p>

    <div class="features-grid">
      <!-- Browser Extension -->
      <div class="feature-card">
        <div class="feature-icon">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="1" y="3" width="14" height="10" rx="2"/>
            <path d="M5 3V2M11 3V2"/>
            <circle cx="8" cy="8" r="2"/>
          </svg>
        </div>
        <h3>Browser extension</h3>
        <p>One-click saving from Chrome or Firefox — no copy-pasting URLs.</p>
      </div>

      <!-- Kindle & Kobo -->
      <div class="feature-card">
        <div class="feature-icon">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="1" width="10" height="14" rx="1.5"/>
            <path d="M6 12h4"/>
          </svg>
        </div>
        <h3>Kindle &amp; Kobo ready</h3>
        <p>Delivers via email-to-Kindle and Kobo's native sideload — no cable needed.</p>
      </div>

      <!-- Clean EPUB -->
      <div class="feature-card">
        <div class="feature-icon">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M2 2h8l4 4v9a1 1 0 01-1 1H3a1 1 0 01-1-1V2z"/>
            <path d="M10 2v4h4M5 9h6M5 12h4"/>
          </svg>
        </div>
        <h3>Clean EPUB output</h3>
        <p>Proper chapter structure, images included, metadata filled — a real book-quality file.</p>
      </div>

      <!-- Article library -->
      <div class="feature-card">
        <div class="feature-icon">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M2 4h12M2 8h12M2 12h8"/>
          </svg>
        </div>
        <h3>Article library</h3>
        <p>Every saved article is stored so you can re-send or download the EPUB anytime.</p>
      </div>

      <!-- Open source -->
      <div class="feature-card">
        <div class="feature-icon">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="8" cy="8" r="6"/>
            <path d="M5 8a3 3 0 016 0"/>
            <circle cx="8" cy="8" r="1" fill="currentColor" stroke="none"/>
          </svg>
        </div>
        <h3>Open source</h3>
        <p>EL2-licensed. Self-host it, audit it, contribute to it — the code is right there on GitHub.</p>
      </div>

      <!-- Free tier -->
      <div class="feature-card">
        <div class="feature-icon">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M8 1l1.5 4.5H14l-3.5 2.5 1.5 4.5L8 10l-4 2.5 1.5-4.5L2 5.5h4.5z"/>
          </svg>
        </div>
        <h3>Generous free tier</h3>
        <p>Start sending articles for free. Upgrade to Pro only when you need unlimited sends.</p>
      </div>
    </div>
  </div>
</section>

<style>
	.features-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
		gap: 1.25rem;
		margin-top: 2.5rem;
	}

	.feature-card {
		background: color-mix(in srgb, var(--ink) 4%, var(--paper));
		border: 1px solid var(--border);
		border-radius: var(--card-radius);
		padding: 1.5rem;
		transition: border-color 0.2s;
	}

	.feature-card:hover {
		border-color: color-mix(in srgb, var(--accent) 40%, transparent);
	}

	.feature-icon {
		width: 2.25rem;
		height: 2.25rem;
		background: color-mix(in srgb, var(--accent) 12%, transparent);
		border-radius: 0.5rem;
		display: grid;
		place-items: center;
		margin-bottom: 0.85rem;
		color: var(--accent);
	}

	.feature-card h3 {
		font-size: 0.95rem;
		font-weight: 600;
		margin: 0 0 0.35rem;
		color: var(--ink);
	}

	.feature-card p {
		font-size: 0.875rem;
		color: var(--muted);
		margin: 0;
		line-height: 1.55;
	}
</style>
