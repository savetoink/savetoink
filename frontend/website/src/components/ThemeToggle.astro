---
// Theme toggle component for dark/light/system mode
---

<button
  id="theme-toggle"
  class="theme-toggle"
  aria-label="Toggle theme mode"
  type="button"
>
  <span class="theme-icon theme-icon-sun" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><path d="M12 1v2"/><path d="M12 21v2"/><path d="M4.22 4.22l1.42 1.42"/><path d="M18.36 18.36l1.42 1.42"/><path d="M1 12h2"/><path d="M21 12h2"/><path d="M4.22 19.78l1.42-1.42"/><path d="M18.36 5.64l1.42-1.42"/></svg>
  </span>
  <span class="theme-icon theme-icon-moon" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
  </span>
  <span class="theme-icon theme-icon-system" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/></svg>
  </span>
</button>

<script is:inline>
  // Theme toggle script - runs inline to avoid FOUC
  (function() {
    const toggle = document.getElementById('theme-toggle');
    const html = document.documentElement;
    const STORAGE_KEY = 'savetoink-theme';
    const THEMES = ['light', 'dark', 'system'];

    // Get theme from localStorage or default to system
    function getTheme() {
      const stored = localStorage.getItem(STORAGE_KEY);
      if (stored && THEMES.includes(stored)) return stored;
      return 'system';
    }

    // Get effective theme (for system mode, resolve to light/dark)
    function getEffectiveTheme(theme) {
      if (theme === 'system') {
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      return theme;
    }

    // Update aria-label based on current mode
    function updateAriaLabel(theme) {
      const labels = {
        light: 'Light mode (click for dark)',
        dark: 'Dark mode (click for system)',
        system: 'System mode (click for light)',
      };
      toggle.setAttribute('aria-label', labels[theme]);
    }

    // Apply theme
    function applyTheme(theme) {
      const effective = getEffectiveTheme(theme);

      // Remove all theme classes
      toggle.classList.remove('theme-toggle--light', 'theme-toggle--dark', 'theme-toggle--system', 'theme-toggle--effective-dark');

      if (theme === 'system') {
        // Remove data-theme to let CSS media queries take over
        html.removeAttribute('data-theme');
        // Add effective-dark class if system prefers dark
        if (effective === 'dark') {
          toggle.classList.add('theme-toggle--effective-dark');
        }
      } else {
        html.setAttribute('data-theme', theme);
      }

      toggle.classList.add(`theme-toggle--${theme}`);
      localStorage.setItem(STORAGE_KEY, theme);
      updateAriaLabel(theme);
    }

    // Initialize
    const theme = getTheme();
    applyTheme(theme);

    // Cycle through themes: light → dark → system → light
    toggle.addEventListener('click', () => {
      const current = getTheme();
      const currentIndex = THEMES.indexOf(current);
      const nextIndex = (currentIndex + 1) % THEMES.length;
      applyTheme(THEMES[nextIndex]);
    });

    // Listen for system preference changes (only if in system mode)
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
      if (getTheme() === 'system') {
        // Just update the effective-dark class, no need to reapply theme
        toggle.classList.toggle('theme-toggle--effective-dark', e.matches);
      }
    });
  })();
</script>

<style>
  .theme-toggle {
    margin: initial;
    margin-left: 0.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    padding: 1;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 0.4rem;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
    color: var(--ink);
  }

  .theme-toggle:hover {
    background: var(--border);
  }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .theme-icon {
    display: none;
  }

  .theme-icon svg {
    width: 20px;
    height: 20px;
  }

  /* Light mode: show sun */
  .theme-toggle--light .theme-icon-sun {
    display: inline-flex;
  }

  /* Dark mode: show moon */
  .theme-toggle--dark .theme-icon-moon {
    display: inline-flex;
  }

  /* System mode: show monitor icon */
  .theme-toggle--system .theme-icon-system {
    display: inline-flex;
  }
</style>
