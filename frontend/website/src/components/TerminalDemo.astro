---
interface Props {
  title?: string;
}

const { title = "terminal" } = Astro.props;
---

<div class="terminal-demo">
  <div class="cli-bar">
    <span class="cli-dot red"></span>
    <span class="cli-dot yellow"></span>
    <span class="cli-dot green"></span>
    <span class="cli-label">{title}</span>
  </div>
  <div class="cli-body">
    <div class="cli-line">
      <span class="cli-prompt">$</span>
      <span class="cli-cmd">docker run \</span>
    </div>
    <div class="cli-line cli-continuation">
      <span class="cli-cmd">ghcr.io/savetoink/savetoink-cli:latest \</span>
    </div>
    <div class="cli-line cli-continuation">
      <span class="cli-cmd">send https://example.com/long-read</span>
    </div>
    <div class="cli-line cli-output">
      <span class="cli-check">✓</span>&nbsp;Fetched &nbsp;
      <span class="cli-check">✓</span>&nbsp;Converted &nbsp;
      <span class="cli-check">✓</span>&nbsp;Sent to Kindle
    </div>
  </div>
</div>

<p>or install the Go binary:</p>

<div class="terminal-demo">
  <div class="cli-bar">
    <span class="cli-dot red"></span>
    <span class="cli-dot yellow"></span>
    <span class="cli-dot green"></span>
    <span class="cli-label">{title}</span>
  </div>
  <div class="cli-body">
    <div class="cli-line">
      <span class="cli-prompt">$</span>
      <span class="cli-cmd">go install \</span>
    </div>
    <div class="cli-line cli-continuation">
      <span class="cli-cmd">github.com/shaftoe/savetoink/cli/savetoink@latest</span>
    </div>
    <div class="cli-line">
      <span class="cli-prompt">$</span>
      <span class="cli-cmd">savetoink send https://example.com/long-read</span>
    </div>
    <div class="cli-line cli-output">
      <span class="cli-check">✓</span>&nbsp;Fetched &nbsp;
      <span class="cli-check">✓</span>&nbsp;Converted &nbsp;
      <span class="cli-check">✓</span>&nbsp;Sent to Kindle
    </div>
  </div>
</div>

<style>
  .terminal-demo {
    max-width: 42rem;
    margin: 0 auto 2.5rem;
    border-radius: 0.75rem;
    border: 1px solid var(--border);
    overflow: hidden;
    text-align: left;
    box-shadow: 0 4px 24px rgba(0,0,0,0.08);
  }

  .cli-bar {
    background: color-mix(in srgb, var(--ink) 8%, var(--paper));
    border-bottom: 1px solid var(--border);
    padding: 0.55rem 0.9rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .cli-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .cli-dot.red    { background: #ff5f57; }
  .cli-dot.yellow { background: #febc2e; }
  .cli-dot.green  { background: #28c840; }

  .cli-label {
    margin-left: auto;
    font-size: 0.7rem;
    color: var(--muted);
    letter-spacing: 0.04em;
    font-family: var(--font-mono);
  }

  .cli-body {
    background: color-mix(in srgb, var(--ink) 5%, var(--paper));
    padding: 1.1rem 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.9;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .cli-line {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .cli-continuation {
    padding-left: 1.25rem;
  }

  .cli-prompt {
    color: var(--accent);
    font-weight: 700;
    user-select: none;
    flex-shrink: 0;
  }

  .cli-cmd {
    color: var(--ink);
    word-break: break-all;
  }

  .cli-output {
    color: var(--muted);
    padding-left: 1.25rem;
    font-size: 0.82rem;
  }

  .cli-check {
    color: #22c55e;
    font-weight: 700;
  }

  @media (max-width: 640px) {
    .cli-body { font-size: 0.78rem; }
  }
</style>
