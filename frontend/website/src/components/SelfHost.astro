---
---

<section class="section" id="self-host">
  <div class="container">
    <p class="section-label">Self-hosting</p>
    <h2 class="section-heading">Backend runs fully serverless on AWS.<br />Or just pull the Docker image.</h2>
    <p class="section-sub">
      Pick your deployment style — a single Docker container for the API server, or the full
      serverless stack on AWS with <code>just deploy</code>.
    </p>

    <div class="deploy-tabs">

      <div class="deploy-option">
        <div class="deploy-option-header">
          <div class="deploy-badge">Docker</div>
          <p class="deploy-option-desc">Fastest way to get running. One pull, one run.</p>
        </div>
        <div class="sh-panel">
          <p class="sh-panel-label">API server</p>
          <div class="sh-code">
            <div class="code-line"><span class="cli-prompt">$</span> <span class="cmd">docker run -p 8080:8080 \</span></div>
            <div class="code-line"><span class="indent"></span><span class="cm">--env-file .env \</span></div>
            <div class="code-line"><span class="indent"></span><span class="str">ghcr.io/savetoink/savetoink-http:latest</span></div>
          </div>
          <p class="sh-panel-label">CLI</p>
          <div class="sh-code sh-code-noborder">
            <div class="code-line"><span class="cli-prompt">$</span> <span class="cmd">docker run --rm \</span></div>
            <div class="code-line"><span class="indent"></span><span class="cm">--env-file .env \</span></div>
            <div class="code-line"><span class="indent"></span><span class="str">ghcr.io/savetoink/savetoink-cli:latest \</span></div>
            <div class="code-line"><span class="indent"></span><span class="cmd">send https://example.com/article</span></div>
          </div>
        </div>
      </div>

      <div class="deploy-option">
        <div class="deploy-option-header">
          <div class="deploy-badge deploy-badge-aws">AWS Serverless</div>
          <p class="deploy-option-desc">Lambda, DynamoDB, CloudFront. No servers to maintain.</p>
        </div>
        <div class="sh-panel">
          <p class="sh-panel-label">deploy</p>
          <div class="sh-code">
            <div class="code-line"><span class="cli-prompt">$</span> <span class="cmd">cp .env.example .env <span class="cm">&amp;&amp; vim .env</span></span></div>
            <div class="code-line"><span class="cli-prompt">$</span> <span class="cmd">just deploy</span></div>
            <div class="code-line">&nbsp;</div>
            <div class="code-line"><span class="out">  ✓ S3 bucket</span></div>
            <div class="code-line"><span class="out">  ✓ ACM certificate</span></div>
            <div class="code-line"><span class="out">  ✓ Lambda (api + processor + scheduler)</span></div>
            <div class="code-line"><span class="out">  ✓ DynamoDB</span></div>
            <div class="code-line"><span class="out">  ✓ CloudFront distribution</span></div>
          </div>
        </div>
        <div class="sh-infra-tags">
          <span class="infra-tag">Lambda</span>
          <span class="infra-tag">DynamoDB</span>
          <span class="infra-tag">CloudFront</span>
          <span class="infra-tag">ACM</span>
          <span class="infra-tag">Auth0</span>
          <span class="infra-tag">Mailjet</span>
        </div>
      </div>

    </div>

    <a href="https://github.com/savetoink/savetoink#self-hosting" class="btn-secondary sh-docs-link" target="_blank" rel="noopener">
      Read the self-hosting docs →
    </a>
  </div>
</section>

<style>
  .deploy-tabs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 2.5rem;
    align-items: start;
  }

  .deploy-option {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .deploy-option-header {
    display: flex !important;
    flex-direction: row !important;
    align-items: center;
    gap: 0.75rem;
  }

  .deploy-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--paper);
    background: var(--ink);
    border-radius: 100px;
    padding: 0.25rem 0.7rem;
    flex-shrink: 0;
  }

  .deploy-badge-aws {
    background: var(--accent);
  }

  .deploy-option-desc {
    font-size: 0.85rem;
    color: var(--muted);
    margin: 0;
    line-height: 1.45;
  }

  .sh-panel {
    border: 1px solid var(--border);
    border-radius: var(--card-radius);
    overflow: hidden;
  }

  .sh-panel-label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    background: color-mix(in srgb, var(--ink) 6%, var(--paper));
    border-bottom: 1px solid var(--border);
    padding: 0.5rem 1rem;
    margin: 0;
  }

  .sh-panel-label + .sh-panel-label {
    border-top: 1px solid var(--border);
  }

  .sh-code {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.75;
    padding: 0.9rem 1.1rem;
    background: color-mix(in srgb, var(--ink) 3%, var(--paper));
    color: var(--ink);
    border-bottom: 1px solid var(--border);
  }

  .sh-code-noborder {
    border-bottom: none;
  }

  .code-line { display: block; }

  .indent { display: inline-block; width: 1.5rem; }

  .cli-prompt {
    color: var(--accent);
    font-weight: 700;
    user-select: none;
    margin-right: 0.4rem;
  }

  .cmd  { color: var(--ink); }
  .cm   { color: var(--muted); }
  .str  { color: #22c55e; }
  .out  { color: #22c55e; padding-left: 0.25rem; }

  .sh-infra-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .infra-tag {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: 100px;
    padding: 0.2rem 0.6rem;
  }

  .sh-docs-link {
    display: inline-flex;
    margin-top: 1.75rem;
  }

  @media (max-width: 768px) {
    .deploy-tabs { grid-template-columns: 1fr; }
  }
</style>
