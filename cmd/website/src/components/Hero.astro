---
---
<section class="hero">
  <div class="ink-blot"></div>

  <div class="hero-left">
    <div class="hero-eyebrow">Open-source · Self-hosted</div>
    <h1>Read later.<br><em>On your Kindle.</em><br>Forever.</h1>
    <p class="hero-sub">
      Save any article from the web, convert it to EPUB, and send it straight
      to your e-reader — no subscriptions, no walled gardens, no expiry.
    </p>
    <div class="hero-actions">
      <a href="https://app.saveto.ink" class="btn-primary">Open App →</a>
      <a href="https://github.com/savetoink/savetoink" class="btn-secondary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
        Self-host it
      </a>
    </div>
    <div class="hero-badge">
      <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor" style="color:var(--rust)"><path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"/></svg>
      MIT License · Open Source
    </div>
  </div>

  <div class="hero-visual">
    <div class="browser-frame">
      <div class="browser-bar">
        <div class="browser-dot"></div>
        <div class="browser-dot"></div>
        <div class="browser-dot"></div>
        <div class="browser-url">app.saveto.ink</div>
      </div>
      <div class="browser-content">
        <div class="app-header">
          <div class="app-logo-mock">save<span>.to.</span>ink</div>
          <div class="app-badge">3 unread</div>
        </div>
        <div class="article-list">
          {[
            { thumb: 1, title: "The Architecture of Resilient Distributed Systems", source: "highscalability.com · 12 min" },
            { thumb: 2, title: "Notes on Writing Readable Go", source: "go.dev · 8 min" },
            { thumb: 3, title: "Why Everything You Know About Memory Is Wrong", source: "nautil.us · 18 min" },
            { thumb: 4, title: "The Last Libraries", source: "newyorker.com · 22 min" },
          ].map((a) => (
            <div class="article-item">
              <div class={`article-thumb thumb-${a.thumb}`}></div>
              <div class="article-meta">
                <div class="article-title">{a.title}</div>
                <div class="article-source">{a.source}</div>
              </div>
              <div class="action-pill send">→ Kindle</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    padding: 7rem 2.5rem 4rem;
    max-width: 1200px;
    margin: 0 auto;
    gap: 4rem;
    position: relative;
  }
  .ink-blot {
    position: absolute;
    width: 500px; height: 500px;
    border-radius: 50%;
    background: var(--rust);
    opacity: 0.06;
    filter: blur(80px);
    top: -100px; right: -200px;
    pointer-events: none;
  }
  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--rust);
    margin-bottom: 1.25rem;
    display: flex; align-items: center; gap: 0.5rem;
  }
  .hero-eyebrow::before {
    content: '';
    width: 2rem; height: 1px;
    background: var(--rust);
  }
  h1 {
    font-family: var(--font-serif);
    font-size: clamp(3rem, 5vw, 5rem);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-bottom: 1.5rem;
  }
  h1 em { font-style: italic; color: var(--rust); }
  .hero-sub {
    font-size: 1.125rem;
    color: #444;
    line-height: 1.7;
    max-width: 480px;
    margin-bottom: 2.5rem;
  }
  .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; align-items: center; }
  .hero-badge {
    margin-top: 2rem;
    display: flex; align-items: center; gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--grey);
    font-family: var(--font-mono);
  }

  /* Browser mockup */
  .browser-frame {
    background: var(--ink);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 32px 80px rgba(13,13,13,0.25), 0 8px 24px rgba(13,13,13,0.15);
    transform: perspective(1000px) rotateY(-4deg) rotateX(2deg);
    transition: transform 0.4s ease;
  }
  .browser-frame:hover { transform: perspective(1000px) rotateY(-1deg) rotateX(0deg); }
  .browser-bar {
    background: #1a1a1a;
    padding: 0.75rem 1rem;
    display: flex; align-items: center; gap: 0.5rem;
  }
  .browser-dot { width: 10px; height: 10px; border-radius: 50%; }
  .browser-dot:nth-child(1) { background: #ff5f57; }
  .browser-dot:nth-child(2) { background: #febc2e; }
  .browser-dot:nth-child(3) { background: #28c840; }
  .browser-url {
    flex: 1;
    background: #2a2a2a;
    border-radius: 4px;
    padding: 0.25rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: #aaa;
    margin-left: 0.75rem;
  }
  .browser-content { background: #111; padding: 1.5rem; min-height: 360px; }
  .app-header {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #222;
  }
  .app-logo-mock { font-family: var(--font-serif); color: var(--paper); font-size: 1rem; font-weight: 700; }
  .app-logo-mock span { color: var(--rust); }
  .app-badge { background: var(--rust); color: white; font-size: 0.65rem; font-family: var(--font-mono); padding: 0.2rem 0.5rem; border-radius: 2px; }
  .article-list { display: flex; flex-direction: column; gap: 0.75rem; }
  .article-item {
    background: #1a1a1a; border-radius: 4px; padding: 0.875rem 1rem;
    display: flex; align-items: center; gap: 0.75rem;
    border-left: 3px solid transparent;
  }
  .article-item:first-child { border-left-color: var(--rust); }
  .article-thumb { width: 40px; height: 40px; border-radius: 2px; flex-shrink: 0; }
  .thumb-1 { background: linear-gradient(135deg, #2a4a6a, #1a3a5a); }
  .thumb-2 { background: linear-gradient(135deg, #3a2a1a, #5a3a2a); }
  .thumb-3 { background: linear-gradient(135deg, #1a3a1a, #2a4a2a); }
  .thumb-4 { background: linear-gradient(135deg, #3a1a3a, #4a2a4a); }
  .article-meta { flex: 1; }
  .article-title { color: #e8e0d8; font-size: 0.8rem; font-weight: 500; margin-bottom: 0.25rem; line-height: 1.3; }
  .article-source { color: #666; font-size: 0.65rem; font-family: var(--font-mono); }
  .action-pill { background: #2a2a2a; border-radius: 2px; padding: 0.2rem 0.5rem; font-size: 0.6rem; font-family: var(--font-mono); color: var(--sepia); white-space: nowrap; }
  .action-pill.send { background: #2a1810; color: var(--rust); }

  /* Animations */
  .hero-left > * { animation: fadeUp 0.6s ease forwards; opacity: 0; }
  .hero-left > *:nth-child(1) { animation-delay: 0.1s; }
  .hero-left > *:nth-child(2) { animation-delay: 0.2s; }
  .hero-left > *:nth-child(3) { animation-delay: 0.3s; }
  .hero-left > *:nth-child(4) { animation-delay: 0.4s; }
  .hero-left > *:nth-child(5) { animation-delay: 0.5s; }
  .hero-visual { animation: fadeUp 0.8s 0.3s ease forwards; opacity: 0; }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; padding-top: 6rem; }
    .hero-visual { display: none; }
  }
</style>
