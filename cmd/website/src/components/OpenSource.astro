<section>
  <div class="section-label">Open Source</div>
  <h2 class="section-title">Built in the open.<br><em>Yours to keep.</em></h2>
  <p class="section-sub">
    MIT licensed. Fork it, extend it, run it at home or on a $5 server.
    No VC, no roadmap surprises, no sunsetting.
  </p>
  <a href="https://github.com/savetoink/savetoink" class="github-pill">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
    View on GitHub
  </a>
</section>

<style>
  section {
    background: var(--cream);
    padding: 5rem 2.5rem;
    text-align: center;
  }
  .section-title {
    max-width: 600px; margin: 0 auto 1rem;
    font-family: var(--font-serif);
    font-size: clamp(2rem, 3vw, 3rem);
    font-weight: 900;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }
  .section-title em { font-style: italic; color: var(--rust); }
  .section-sub { margin: 0 auto 2.5rem; max-width: 480px; }
  .github-pill {
    display: inline-flex; align-items: center; gap: 0.75rem;
    background: var(--ink);
    color: var(--paper);
    text-decoration: none;
    padding: 0.875rem 2rem;
    border-radius: 2px;
    font-size: 0.875rem;
    font-weight: 500;
    transition: background 0.2s;
  }
  .github-pill:hover { background: #333; }
</style>
