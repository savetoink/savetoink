---
---
<section>
  <div class="section-label">Get started</div>
  <h2 class="section-title">Your reading list.<br>On your Kindle. Tonight.</h2>
  <p class="section-sub">
    It takes about 10 minutes to deploy. Then you'll never lose a good article again.
  </p>
  <a href="https://app.saveto.ink" class="btn-cta">Open the app →</a>
</section>

<style>
  section {
    background: var(--rust);
    color: var(--paper);
    text-align: center;
    padding: 5rem 2.5rem;
  }
  .section-label { color: rgba(245,240,232,0.6); font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase; margin-bottom: 0.75rem; }
  .section-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 3vw, 3rem);
    font-weight: 900;
    letter-spacing: -0.025em;
    line-height: 1.1;
    color: var(--paper);
    max-width: 600px; margin: 0 auto 1rem;
  }
  .section-sub { color: rgba(245,240,232,0.8); margin: 0 auto 2.5rem; max-width: 480px; }
  .btn-cta {
    display: inline-flex; align-items: center; gap: 0.5rem;
    background: var(--paper);
    color: var(--rust);
    text-decoration: none;
    padding: 0.875rem 2.25rem;
    border-radius: 2px;
    font-size: 0.9rem;
    font-weight: 600;
    transition: transform 0.15s;
  }
  .btn-cta:hover { transform: translateY(-2px); }
</style>
