---
---
<section id="cli">
  <div class="inner">
    <div class="text">
      <div class="section-label">CLI Tool</div>
      <h2 class="section-title">Command-line interface</h2>
      <p class="section-sub">
        The CLI converts any URL to EPUB locally or sends it to your Kindle.
        Use it in scripts or automate with cron.
      </p>
      <a href="https://github.com/savetoink/savetoink" class="btn-outline">
        Installation docs ↗
      </a>
    </div>

    <div class="terminal">
      <div class="t-bar">
        <span class="d"></span><span class="d"></span><span class="d"></span>
      </div>
      <div class="t-body">
        <span class="comment"># install the CLI</span>
        <span><span class="prompt">$</span> <span class="cmd">go build -o bin/savetoink cmd/cli</span></span>
        <span>&nbsp;</span>
        <span class="comment"># save locally as EPUB</span>
        <span><span class="prompt">$</span> <span class="cmd">savetoink convert https://go.dev/doc/effective_go</span></span>
        <span class="out">Fetching article...</span>
        <span class="out">Title: <span class="hi">Effective Go</span></span>
        <span class="out">Generated in 7ms</span>
        <span class="ok">✓ EPUB saved to: effective_go.epub</span>
        <span>&nbsp;</span>
        <span class="comment"># or send straight to Kindle</span>
        <span><span class="prompt">$</span> <span class="cmd">savetoink convert https://... --send</span></span>
        <span class="out">Sending to Kindle: you@kindle.com</span>
        <span class="ok">✓ Article sent to Kindle</span>
      </div>
    </div>
  </div>
</section>

<style>
  section { background: #0a0a0a; padding: 5rem 2.5rem; }
  .inner {
    max-width: 1200px; margin: 0 auto;
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 4rem; align-items: center;
  }
  .section-label { color: var(--sepia); }
  .section-title { color: var(--paper); }
  .section-sub { color: #888; margin-bottom: 2rem; }
  .btn-outline {
    display: inline-flex; align-items: center;
    text-decoration: none;
    color: var(--paper);
    font-size: 0.9rem;
    font-weight: 500;
    padding: 0.85rem 1.5rem;
    border: 1px solid #333;
    border-radius: 2px;
    transition: border-color 0.2s;
  }
  .btn-outline:hover { border-color: var(--sepia); }

  /* Terminal */
  .terminal {
    background: #0d0d0d;
    border: 1px solid #2a2a2a;
    border-radius: 6px;
    overflow: hidden;
    font-family: var(--font-mono);
  }
  .t-bar {
    background: #1a1a1a;
    padding: 0.6rem 1rem;
    display: flex; gap: 0.5rem; align-items: center;
  }
  .d { width: 9px; height: 9px; border-radius: 50%; }
  .d:nth-child(1) { background: #ff5f57; }
  .d:nth-child(2) { background: #febc2e; }
  .d:nth-child(3) { background: #28c840; }
  .t-body {
    padding: 1.5rem;
    font-size: 0.8rem;
    line-height: 1.8;
    display: flex;
    flex-direction: column;
  }
  .prompt { color: var(--rust); }
  .cmd { color: #e8e0d8; }
  .comment { color: #555; }
  .out { color: #888; }
  .ok { color: #28c840; }
  .hi { color: var(--sepia); }

  @media (max-width: 900px) {
    .inner { grid-template-columns: 1fr; }
  }
</style>
