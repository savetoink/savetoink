{
  "name": "savetoink",
  "description": "Save to Ink browser extension",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "postinstall": "wxt prepare",
    "icons:generate": "bun run ../../tools/generate_icons.ts ../../favicon.svg icon-targets.csv"
  },
  "dependencies": {
    "@savetoink/shared": "*"
  },
  "devDependencies": {
    "@tsconfig/svelte": "^5.0.7",
    "@wxt-dev/module-svelte": "^2.0.4",
    "svelte": "^5.49.2",
    "svelte-check": "^4.3.6",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "wxt": "^0.20.18",
    "@types/bun": "latest"
  }
}
